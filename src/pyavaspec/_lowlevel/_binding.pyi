""":file:`_binding.py` 的静态类型定义"""

import os
from collections.abc import Callable
from typing import Any

AvsHandle = int
SensorType = int
uint8 = int
# uint16 = int
# uint32 = int
# int32 = int

class _AvaSpecxNative:
    path: str
    lib: Any
    def __init__(
        self,
        path: str | os.PathLike[str],
        *,
        loader: Callable[[str], Any] | None = ...,
    ) -> None: ...
    def _setup_bindings(self) -> None: ...

    # %% 会话
    def _Init(self, a_Port: int) -> int: ...
    def _Done(self) -> int: ...
    def _UpdateUSBDevices(self) -> int: ...

    # %% 设备枚举、激活
    def _GetList(self, a_ListSize: int, a_pRequiredSize: Any, a_pList: Any) -> int: ...
    def _Activate(self, a_pDeviceId: Any) -> int: ...
    def _Deactivate(self, a_hDeviceId: int) -> bool: ...

    # %% 版本信息
    def _GetVersionInfo(
        self,
        a_hDevice: AvsHandle,
        a_pFPGAVersion: Any,
        a_pFirmwareVersion: Any,
        a_pDLLVersion: Any,
    ) -> int: ...
    def _GetDLLVersion(self, a_pVersionString: Any) -> int: ...

    # %% 设备信息
    def _GetNumPixels(self, a_hDevice: AvsHandle, a_pNumPixels: Any) -> int: ...
    def _GetLambda(self, a_hDevice: AvsHandle, a_pWavelength: Any) -> int: ...
    def _UseHighResAdc(self, a_hDevice: AvsHandle, a_Enable: bool) -> int: ...

    # %% 采集
    def _PrepareMeasure(self, a_hDevice: AvsHandle, a_pMeasConfig: Any) -> int: ...
    def _Measure(self, a_hDevice: AvsHandle, a_hWnd: int | None, a_Nmsr: int) -> int: ...
    def _StopMeasure(self, a_hDevice: AvsHandle) -> int: ...
    def _ForceStopMeas(self, a_hDevice: AvsHandle) -> int: ...
    def _PollScan(self, a_hDevice: AvsHandle) -> int: ...
    def _GetScopeData(self, a_hDevice: AvsHandle, a_pTimeLabel: Any, a_pSpectrum: Any) -> int: ...

    # %% 配置读写
    def _GetParameter(
        self,
        a_hDevice: AvsHandle,
        a_Size: int,
        a_pRequiredSize: Any,
        a_pData: Any,
    ) -> int: ...
    def _SetParameter(self, a_hDevice: AvsHandle, a_pData: Any) -> int: ...

    # %% 辅助方法
    def _GetSaturatedPixels(self, a_hDevice: AvsHandle, a_pSaturated: Any) -> int: ...
    def _GetMeasPixels(self, a_hDevice: AvsHandle, a_pNumPixels: Any) -> int: ...
    def _GetAnalogIn(self, a_hDevice: AvsHandle, a_AnalogInId: uint8, a_pAnalogIn: Any) -> int: ...

    # %% Digital IO
    def _GetDigIn(self, a_hDevice: AvsHandle, a_DigInId: uint8, a_pDigIn: Any) -> int: ...
    def _SetDigOut(self, a_hDevice: AvsHandle, a_PortId: uint8, a_Value: uint8) -> int: ...
    def _SetPrescanMode(self, a_hDevice: AvsHandle, a_Prescan: bool) -> int: ...

    # %% 原始数据、CRC
    def _GetRawScopeDataCRC(
        self,
        a_hDevice: AvsHandle,
        a_pTimeLabel: Any,
        a_pAvg: Any,
        a_pCRC32: Any,
        a_nrPixels: Any,
        a_pSpectrum: Any,
    ) -> int: ...
    def _CheckCRC(
        self, a_CRC32: int, a_NrPixels: int, a_Use16Bit: bool, a_pSpectrum: Any
    ) -> bool: ...
    def _EnableCRC(self, a_hDevice: AvsHandle, a_enableCRC: bool) -> int: ...

    # %% 杂散光抑制
    def _SuppressStrayLight(
        self,
        a_hDevice: AvsHandle,
        a_MultiFactor: float,
        a_pSrcSpectrum: Any,
        a_pDestSpectrum: Any,
    ) -> int: ...

    # %% 模拟输出、PWM、同步、灵敏度
    def _SetAnalogOut(self, a_hDevice: AvsHandle, a_PortId: uint8, a_Value: float) -> int: ...
    def _SetPwmOut(
        self,
        a_hDevice: AvsHandle,
        a_PortId: uint8,
        a_Frequency: int,
        a_DutyCycle: int,
    ) -> int: ...
    def _SetSyncMode(self, a_hDevice: AvsHandle, a_Enable: int) -> int: ...
    def _SetSensitivityMode(self, a_hDevice: AvsHandle, a_SensitivityMode: int) -> int: ...
    def _ResetDevice(self, a_hDevice: AvsHandle) -> int: ...

    # %% 额外只读查询（非头文件导出）
    def _GetDetectorName(
        self, a_hDevice: AvsHandle, a_SensorType: SensorType, a_pName: Any
    ) -> int: ...
    def _GetDeviceType(self, a_hDevice: AvsHandle, a_pType: Any) -> int: ...
    def _GetStatusBySerial(self, a_pSerial: bytes, a_pStatus: Any) -> int: ...
